<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MapsActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:layout_margin="16dp"
        android:background="@drawable/bg_search_bar"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="6dp">

        <EditText
            android:id="@+id/etSearchDestination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints=""
            android:background="@android:color/transparent"
            android:hint="@string/hint_search_destination"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/text_dark"
            android:textColorHint="@color/hint_gray"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/btnSearch"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_search_button"
            android:contentDescription="@string/btn_search"
            android:padding="10dp"
            android:src="@drawable/ic_search" />

    </LinearLayout>

    <Button
        android:id="@+id/btnFinishTrip"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_margin="16dp"
        android:background="@drawable/bg_finish_button"
        android:elevation="8dp"
        android:enabled="false"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.02"
        android:text="@string/btn_finish_trip"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:textSize="15sp" />

</FrameLayout>
